# GCP Configuration
GOOGLE_CLOUD_PROJECT=hockeystack-pe

# Model
MODEL=gemini-2.5-flash

# Big Query
BQ_LOCATION=US
MAX_BYTES_BILLED=5000000000

# Agent
MAX_TURNS=5
MAX_PROMPTS_PER_USER_PER_DAY=10
MAX_PROMPT_CHARS=4000
MAX_CONVERSATION_CHARS=16000
MAX_CONVERSATION_MESSAGES=20
MAX_OUTPUT_TOKENS=4096
FIRESTORE_EMULATOR_HOST=

# Budget
DAILY_BUDGET_USD=2
CACHE_TTL_SECONDS=900

# Server
PORT=8080
LOG_LEVEL=info
